{
  "name": "prompter",
  "version": "0.1.0",
  "private": true,
  "description": "Prompter — Visual Prompt Design Tool (Sprint 0 foundation)",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm verify:isolation",
    "verify": "pnpm check && pnpm test:e2e",
    "verify:isolation": "node scripts/verify-prod-isolation.mjs",
    "perf": "playwright test --config playwright.perf.config.ts",
    "perf:bundle": "node scripts/measure-bundle.mjs"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
